# BordeGuna-HeadQuarter STAGING environment template (deploy/staging/docker-compose.yml). Copy to
# deploy/staging/.env (600, root, never in git) only when a person decides to start staging.
#
# ⛔ Every secret here is NEW and staging's own. Never copy a value from deploy/.env: not APP_KEY (it
# would decrypt production's stored credentials), not a database or redis password, not a Meta, OpenAI,
# ERP or shop credential. Staging talks to Meta's TEST Page in development mode and to nothing else.

HQ_STAGING_DOMAIN=              # e.g. hq-staging.<a domain Joy controls>; NEVER hq.bordeguna.com

APP_NAME="BordeGuna HQ (staging)"
APP_ENV=staging
APP_KEY=                        # a NEW key: docker run --rm php:8.3-cli php -r "echo 'base64:'.base64_encode(random_bytes(32));"
APP_DEBUG=false
APP_URL=https://${HQ_STAGING_DOMAIN}
APP_TIMEZONE=UTC
APP_VERSION=staging
HQ_DEFAULT_TIMEZONE=Asia/Dhaka

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=hq_staging
DB_USERNAME=hq_staging
DB_PASSWORD=                    # NEW: openssl rand -base64 32 | tr -d '/+='

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=${HQ_STAGING_DOMAIN}

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=                 # NEW: openssl rand -base64 32 | tr -d '/+='
REDIS_PORT=6379

HORIZON_PREFIX=hq-staging:

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@bordeguna.com
MAIL_FROM_NAME="${APP_NAME}"

# No ERP, no shop, no alerting bot: staging reads nothing real.
HQ_ERP_BASE_URL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
