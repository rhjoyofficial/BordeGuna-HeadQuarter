9b9\u09c3\u09a4 \u09b9\u09af\u09bc \u09ac\u09cd\u09b2\u09bf\u099a\u09bf\u0982 \u0993 \u09b8\u09be\u09b2\u09ab\u09be\u09b0-\u09aa\u09cd\u09b0\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be\u0964\r\n                \u09ab\u09b2\u09be\u09ab\u09b2: \u099a\u09cb\u0996\u09c7 \u09b8\u09c1\u09a8\u09cd\u09a6\u09b0, \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 \u0986\u0996\u09c7\u09b0 \u0986\u09b8\u09b2 \u09b0\u09c2\u09aa \u09a5\u09c7\u0995\u09c7 \u0985\u09a8\u09c7\u0995 \u09a6\u09c2\u09b0\u09c7\u0964\r\n            <\/p>\r\n        <\/div>\r\n\r\n        <div>\r\n            <h3 class=\"text-2xl font-semibold text-gray-900 mb-4\">\r\n                \u09b2\u09be\u09b2 \u099a\u09bf\u09a8\u09bf\u09a4\u09c7 \u0995\u09c0 \u09a5\u09be\u0995\u09c7?\r\n            <\/h3>\r\n\r\n            <p>\r\n                \u09af\u09c7\u09b9\u09c7\u09a4\u09c1 \u09b2\u09be\u09b2 \u099a\u09bf\u09a8\u09bf \u0995\u09ae \u09aa\u09b0\u09bf\u09b6\u09cb\u09a7\u09bf\u09a4, \u098f\u09a4\u09c7 \u0986\u0996\u09c7\u09b0 \u09aa\u09cd\u09b0\u09be\u0995\u09c3\u09a4\u09bf\u0995 \u09ac\u09be\u09a6\u09be\u09ae\u09bf \u09b0\u0999,\r\n                \u0995\u09bf\u099b\u09c1\u099f\u09be \u09ae\u09cb\u09b2\u09be\u09b8\u09c7\u09b8 (\u0997\u09c1\u09a1\u09bc\u09c7\u09b0 \u0985\u0982\u09b6) \u098f\u09ac\u0982 \u09b8\u09cd\u09ac\u09be\u09ad\u09be\u09ac\u09bf\u0995 \u09b8\u09cd\u09ac\u09be\u09a6-\u0997\u09a8\u09cd\u09a7 \u0985\u099f\u09c1\u099f \u09a5\u09be\u0995\u09c7\u0964\r\n                \u0985\u09a8\u09c7\u0995\u09c7\u0987 \u098f\u09b0 \u0997\u09ad\u09c0\u09b0, \u0989\u09b7\u09cd\u09a3 \u09b8\u09cd\u09ac\u09be\u09a6 \u09aa\u099b\u09a8\u09cd\u09a6 \u0995\u09b0\u09c7\u09a8 \u2014 \u099a\u09be \u09a5\u09c7\u0995\u09c7 \u09aa\u09be\u09af\u09bc\u09c7\u09b8,\r\n                \u09b8\u09c7\u09ae\u09be\u0987, \u09aa\u09bf\u09a0\u09be \u0995\u09bf\u0982\u09ac\u09be \u09ac\u09bf\u09ad\u09bf\u09a8\u09cd\u09a8 \u09a1\u09c7\u099c\u09be\u09b0\u09cd\u099f\u2014\u09b8\u09ac\u0995\u09bf\u099b\u09c1\u09a4\u09c7\u0987 \u098f\u09b0 \u09b8\u09cd