# deploy/.env - production environment for the bordeguna-hq compose stack.
# Copy to deploy/.env on the VPS, chmod 600, fill every value. NEVER commit deploy/.env.
# Secrets stay in this file only: never printed, never in docs, never pasted into chat.

APP_NAME="BordeGuna HQ"
APP_ENV=production
APP_KEY=                       # generate: docker run --rm php:8.3-cli php -r "echo 'base64:'.base64_encode(random_bytes(32));"  (decrypts integration_credentials; losing it loses every stored credential)
APP_DEBUG=false
APP_URL=https://hq.bordeguna.com
APP_TIMEZONE=UTC
APP_VERSION=phase-0
HQ_DEFAULT_TIMEZONE=Asia/Dhaka

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=hq
DB_USERNAME=hq
DB_PASSWORD=                   # openssl rand -base64 32 | tr -d '/+='

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=hq.bordeguna.com

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=                # openssl rand -base64 32 | tr -d '/+='
REDIS_PORT=6379

HORIZON_PREFIX=hq:

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@bordeguna.com
MAIL_FROM_NAME="${APP_NAME}"

# Backups (backup container): local pg_dump -Fc into /root/backups/bordeguna-hq on the host.
# NOT disaster-proof (same VPS). No offsite provider is part of the current deployment.
BACKUP_HOUR_UTC=01
RETAIN_DAILY=14
RETAIN_WEEKLY=8
# Future extension point: an executable that receives the verified dump path as $1. Leave empty.
OFFSITE_HOOK=

# Alerts (backup container + host monitor). Leave empty to disable Telegram notices.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# ERP HQ API (bordeguna-erp). Per-business tokens live in integration_credentials, never here.
HQ_ERP_BASE_URL=https://erp.bordeguna.com
HQ_ERP_TIMEOUT=15

# Event drain pause (docs/132). OFF unless set. While true, hq:events:process claims nothing: webhooks are still
# recorded as pending `events` rows and wait. Set it BEFORE a release that must not resume the drain (docs/131
# Stage D step 4: deploy.sh's `up -d` starts a stopped scheduler); remove it and recreate the scheduler only when
# replay is authorised.
# HQ_EVENTS_DRAIN_PAUSED=true
