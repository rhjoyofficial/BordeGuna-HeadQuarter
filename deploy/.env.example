# deploy/.env - production environment for the bordeguna-hq compose stack.
# Copy to deploy/.env on the VPS, chmod 600, fill every value. NEVER commit deploy/.env.

APP_NAME="BordeGuna HQ"
APP_ENV=production
APP_KEY=                       # php artisan key:generate --show   (also store in the password manager: it decrypts integration_credentials)
APP_DEBUG=false
APP_URL=https://hq.bordeguna.com
APP_TIMEZONE=UTC
APP_VERSION=phase-0
HQ_DEFAULT_TIMEZONE=Asia/Dhaka

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=hq
DB_USERNAME=hq
DB_PASSWORD=                   # openssl rand -base64 32

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=hq.bordeguna.com

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=                # openssl rand -base64 32
REDIS_PORT=6379

HORIZON_PREFIX=hq:

MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@bordeguna.com
MAIL_FROM_NAME="${APP_NAME}"

# Backups (backup container). Offsite is optional but loudly warned about when missing.
BACKUP_HOUR_UTC=01
RESTIC_REPOSITORY=b2:bordeguna-erp-backup:hq
RESTIC_PASSWORD=               # openssl rand -base64 32  -> password manager FIRST; unrecoverable if lost
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=

# Alerts (backup container + monitoring). Leave empty to disable Telegram notices.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
